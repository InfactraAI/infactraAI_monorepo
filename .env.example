# ── Server ──────────────────────────────
PORT=3000

# ── JWT ─────────────────────────────────
JWT_SECRET=change_me_in_production

# ── MySQL ───────────────────────────────
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=root
DB_NAME=jayanitha

# ── MongoDB ─────────────────────────────
# Overridden by docker-compose to use service name; set for local-only dev
MONGO_URI=mongodb://localhost:27017/infactra_db

# ── Email ───────────────────────────────
EMAIL_USER=you@example.com
EMAIL_PASS=app_specific_password

# ── Frontend URL (used by CORS) ──────────
FRONTEND_URL=http://localhost

# ── Microsoft / OneDrive ────────────────
CLIENT_ID=your_azure_client_id
CLIENT_SECRET=your_azure_client_secret
TENANT_ID=common
REDIRECT_URI=http://localhost/onedrive/callback
