# ── Server ──────────────────────────────
PORT=3000

# ── JWT ─────────────────────────────────
JWT_SECRET=change_me_in_production

# ── MySQL ───────────────────────────────
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=root
DB_NAME=jayanitha

# ── MongoDB ─────────────────────────────
# Overridden by docker-compose to use service name; set for local-only dev
MONGO_URI=mongodb://localhost:27017/infactra_db

# ── Email ───────────────────────────────
EMAIL_USER=you@example.com
EMAIL_PASS=app_specific_password

# ── Frontend URL (used by CORS) ──────────
FRONTEND_URL=http://localhost

# ── Public base URL of this API (used to build upload URLs) ──
API_BASE_URL=http://localhost

# ── AES key for encrypting stored OAuth tokens ──
# Generate: openssl rand -hex 32
CRYPTO_SECRET=change_me_too

# ── Microsoft / OneDrive ────────────────
CLIENT_ID=your_azure_client_id
CLIENT_SECRET=your_azure_client_secret
TENANT_ID=common
REDIRECT_URI=http://localhost/onedrive/callback

# ── Google Sheets ───────────────────────
# One OAuth client for the whole install. Users never see these — they just
# click Connect. Create at console.cloud.google.com → APIs & Services.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost/google/callback
# Browser-key + project number, both required by the Google Picker
GOOGLE_API_KEY=your_google_api_key
GOOGLE_PROJECT_NUMBER=your_gcp_project_number
