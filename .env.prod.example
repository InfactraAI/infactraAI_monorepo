# ── Deployment settings (this file lives at the repo root, as .env) ──────────
# Read by docker-compose.yml. Application settings live in apps/api/.env.
#
#   cp .env.prod.example .env    &&    edit

# Public hostname. Must be a real DNS name pointing at this server — Google
# rejects bare IPs and plain http:// for OAuth redirect URIs.
APP_DOMAIN=app.yourdomain.com

# MongoDB credentials. These are applied only when the data volume is first
# created — changing them later needs a manual user update inside mongosh.
MONGO_USER=infactra
MONGO_PASSWORD=change_me_to_a_long_random_string
MONGO_DB=infactra_db
