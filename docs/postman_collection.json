{
  "info": {
    "name": "Infactra API",
    "description": "Multi-tenant Infactra API.\n\nEvery request except those marked Public needs `Authorization: Bearer {{token}}`.\nThe organisation is read from the token \u2014 never pass an orgId or userId.\n\nStart with Auth \u2192 Login; it stores the JWT in {{token}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invite_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "member_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "invite_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sheet_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "spreadsheet_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.test\",\n  \"password\": \"Admin@123\"\n}"
            },
            "description": "Returns a JWT carrying orgId. Saved to {{token}} by the test script."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) {",
                  "  pm.collectionVariables.set('token', d.token);",
                  "  console.log('Signed in to', d.organization && d.organization.name);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (creates an organisation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ann Admin\",\n  \"organizationName\": \"Acme Exports Pvt Ltd\",\n  \"email\": \"ann@acme.test\",\n  \"password\": \"pw12345678\",\n  \"mobile\": \"9000000001\",\n  \"address\": \"HQ, Mumbai\"\n}"
            },
            "description": "Public. Creates a NEW organisation; the registrant becomes its owner and ADMIN. To join an existing organisation use an invitation instead."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/forgotPassword",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgotPassword"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.test\"\n}"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/resetPassword",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "resetPassword"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"FROM_EMAIL_LINK\",\n  \"password\": \"newpw12345678\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Organisation & team",
      "item": [
        {
          "name": "List members and invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/org/members",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "members"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Any member may read. canManage reports whether the caller is an ADMIN."
          }
        },
        {
          "name": "Invite a member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/org/invites",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "invites"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newhire@acme.test\",\n  \"role\": \"USER\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "ADMIN only. If SMTP is unconfigured the response carries inviteLink for manual sharing."
          }
        },
        {
          "name": "Resend invitation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/org/invites/{{invite_id}}/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "invites",
                "{{invite_id}}",
                "resend"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "ADMIN only. Issues a fresh token; the previous link stops working."
          }
        },
        {
          "name": "Revoke invitation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/org/invites/{{invite_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "invites",
                "{{invite_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "ADMIN only."
          }
        },
        {
          "name": "Change a member's role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/org/members/{{member_id}}/role",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "members",
                "{{member_id}}",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "ADMIN only. The owner's role cannot be changed, and the last admin cannot be demoted."
          }
        },
        {
          "name": "Remove a member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/org/members/{{member_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "members",
                "{{member_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "ADMIN only. The owner cannot be removed, and you cannot remove yourself."
          }
        },
        {
          "name": "Look up an invitation (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/org/invites/lookup?token={{invite_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "invites",
                "lookup"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{invite_token}}"
                }
              ]
            },
            "description": "Public. Lets the accept page show the organisation before sign-up."
          }
        },
        {
          "name": "Accept an invitation (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/org/invites/accept",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "org",
                "invites",
                "accept"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{invite_token}}\",\n  \"name\": \"New Hire\",\n  \"password\": \"pw12345678\"\n}"
            },
            "description": "Public. Single-use. Returns a JWT so the invitee lands signed in."
          }
        }
      ]
    },
